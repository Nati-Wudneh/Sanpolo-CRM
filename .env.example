# Copy this file to .env.local and fill in real values, then restart the app.

# Password required to use the CRM. Leave unset for local development to
# skip the login screen entirely. MUST be set for any public deployment —
# without it, anyone with the URL can view and edit everything.
APP_PASSWORD=

# Where the SQLite database lives. Leave unset locally (defaults to ./data).
# In production, point this at a mounted persistent volume, e.g. /data —
# otherwise the database is wiped on every redeploy/restart.
DB_DIR=

# Optional — only needed to use the Gmail sync/send feature. See the
# "Gmail" section on the Settings page in the app for step-by-step
# instructions on creating these in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
